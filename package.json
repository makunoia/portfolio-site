{
  "name": "portfolio-site",
  "description": "A portfolio site made with Payload CMS 3.0 and Next.js 16",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "devturbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "node set-build-date.js",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "ci": "payload migrate && npm build",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "embed:personal": "node embedding/script.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.80",
    "@ai-sdk/react": "^2.0.109",
    "@aws-sdk/client-s3": "^3.946.0",
    "@lexical/headless": "^0.38.2",
    "@lexical/html": "^0.38.2",
    "@lexical/link": "^0.38.2",
    "@lexical/list": "^0.38.2",
    "@lexical/mark": "^0.38.2",
    "@lexical/react": "^0.38.2",
    "@lexical/rich-text": "^0.38.2",
    "@lexical/selection": "^0.38.2",
    "@lexical/table": "^0.38.2",
    "@lexical/utils": "^0.38.2",
    "@next/bundle-analyzer": "^16.0.7",
    "@payloadcms/db-mongodb": "^3.67.0",
    "@payloadcms/db-postgres": "^3.67.0",
    "@payloadcms/email-nodemailer": "^3.67.0",
    "@payloadcms/next": "^3.67.0",
    "@payloadcms/richtext-lexical": "^3.67.0",
    "@payloadcms/storage-s3": "^3.67.0",
    "@payloadcms/ui": "^3.67.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "ai": "^5.0.108",
    "babel-plugin-react-compiler": "19.0.0-beta-decd7b8-20250118",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "cross-env": "^10.1.0",
    "exifr": "^7.1.3",
    "globe.gl": "^2.45.0",
    "graphql": "^16.12.0",
    "lexical": "^0.38.2",
    "mixpanel-browser": "^2.72.0",
    "motion": "^12.23.25",
    "next": "^16.0.7",
    "next-themes": "^0.4.6",
    "payload": "^3.67.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/env": "^16.0.7",
    "@radix-ui/react-form": "^0.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@swc/core": "^1.15.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.181.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "cssnano": "^7.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3"
  }
}
